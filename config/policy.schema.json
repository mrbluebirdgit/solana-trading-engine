{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bluebird.local/schemas/solana-trading-policy-v1.json",
  "title": "Solana Trading Engine Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "projectName",
    "status",
    "chain",
    "venues",
    "operatingMode",
    "alerts",
    "freshnessAndExecution",
    "portfolioRisk",
    "entityScoring",
    "discovery",
    "tokenSafety",
    "inputGovernance",
    "paperAcceptance",
    "signerSecurity"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "policyVersion": { "const": "1.2.0" },
    "projectName": { "const": "solana-trading-engine" },
    "status": { "enum": ["BUILDING", "PAPER", "LIVE_LOCKED", "PAUSED"] },
    "chain": { "const": "solana" },
    "venues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "operatingMode": {
      "type": "object",
      "required": ["liveTrading", "paperTradingRequired", "explicitActivationPhrase", "failClosed"],
      "properties": {
        "liveTrading": { "const": false },
        "paperTradingRequired": { "const": true },
        "explicitActivationPhrase": { "const": "ENABLE LIVE TRADING" },
        "failClosed": { "const": true }
      }
    },
    "alerts": { "$ref": "#/$defs/object" },
    "freshnessAndExecution": { "$ref": "#/$defs/object" },
    "portfolioRisk": { "$ref": "#/$defs/object" },
    "entityScoring": { "$ref": "#/$defs/object" },
    "discovery": { "$ref": "#/$defs/object" },
    "tokenSafety": { "$ref": "#/$defs/object" },
    "inputGovernance": { "$ref": "#/$defs/inputGovernance" },
    "paperAcceptance": { "$ref": "#/$defs/object" },
    "signerSecurity": { "$ref": "#/$defs/object" }
  },
  "$defs": {
    "object": {
      "type": "object",
      "minProperties": 1
    },
    "inputGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walletInputs"],
      "properties": {
        "walletInputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryShipsWithPreloadedEntries",
            "staticWatchlistsRequireExplicitUserApproval",
            "maximumAuthority"
          ],
          "properties": {
            "repositoryShipsWithPreloadedEntries": { "const": false },
            "staticWatchlistsRequireExplicitUserApproval": { "const": true },
            "maximumAuthority": { "const": "candidate_nomination" }
          }
        }
      }
    }
  }
}
