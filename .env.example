# Non-secret runtime controls
NODE_ENV=development
TRADING_MODE=observe
LIVE_TRADING_ENABLED=false

# Observation worker controls. `npm start` enables notifications and will fail
# closed unless exactly one complete channel is configured below.
PORT=3000
OBSERVATION_LOG_PATH=data/observations.jsonl
OBSERVER_CONCURRENCY=4
OBSERVER_MAX_QUEUE=250
OBSERVER_MAX_EVENT_AGE_MS=30000
OBSERVER_DEDUPE_TTL_MS=3600000
OBSERVER_MAX_DEDUPE=50000

# Optional observation-only narrative radar. It requires at least one explicit
# discovery source below and never grants trading authority. X recent search
# and GDELT are bounded confirmation calls and remain off unless enabled.
NARRATIVE_RADAR_ENABLED=false
# Leave blank to enable generic alerts only when the narrative radar is off.
GENERIC_OPPORTUNITY_ALERTS_ENABLED=
NARRATIVE_POLL_INTERVAL_MS=1200000
NARRATIVE_ALERT_MIN_PRIORITY=70
NARRATIVE_CONFIRMATION_MAX_TERMS=3
NARRATIVE_X_WOEIDS=1
NARRATIVE_NEWS_COUNTRIES=us
NARRATIVE_X_RECENT_SEARCH_ENABLED=false
NARRATIVE_GDELT_ENABLED=false
NARRATIVE_RSS_FEEDS=
# Production plan gates. Hobby LunarCrush has no social-topic access, and
# Developer NewsAPI is delayed and licensed for development only.
LUNARCRUSH_DAILY_REQUEST_LIMIT=100
LUNARCRUSH_DAILY_REQUEST_RESERVE=10
LUNARCRUSH_PLAN=hobby
NEWSAPI_DAILY_REQUEST_LIMIT=100
NEWSAPI_DAILY_REQUEST_RESERVE=10
NEWSAPI_PLAN=developer

# Candidate-triggered market intelligence. These providers are queried only
# after a narrative match clears the alert threshold, never for every Pump mint.
BIRDEYE_API_KEY=
GMGN_API_KEY=
SOLSCAN_API_KEY=
CANDIDATE_PROVIDER_TIMEOUT_MS=6000
BIRDEYE_DAILY_REQUEST_LIMIT=100
BIRDEYE_DAILY_REQUEST_RESERVE=10
GMGN_DAILY_REQUEST_LIMIT=50
GMGN_DAILY_REQUEST_RESERVE=5
SOLSCAN_DAILY_REQUEST_LIMIT=250
SOLSCAN_DAILY_REQUEST_RESERVE=25

# Persisted post-alert price checks at 1m, 5m, 15m, and 60m. No fee/slippage
# claim is made, and these observations never grant trading authority.
NARRATIVE_OUTCOME_TRACKING_ENABLED=
NARRATIVE_OUTCOME_NOTIFICATIONS_ENABLED=true
NARRATIVE_OUTCOME_CHECKPOINTS_MS=60000,300000,900000,3600000

# Telegram user API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Reserved for the future Telegram user client. No session is generated by the
# current repository; QR authorization will be preferred when implemented.
TELEGRAM_SESSION_PATH=.secrets/telegram.session

# Helius Solana RPC and data infrastructure
HELIUS_API_KEY=

# Jupiter supplies read-only price and route data. Wallet signing remains local.
JUPITER_API_KEY=

# Telegram Bot API for alerts. Authenticated control commands are future work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Remaining market, wallet, social, and verification sources
CIELO_API_KEY=
X_BEARER_TOKEN=
LUNARCRUSH_API_KEY=
NEWSAPI_KEY=
SECONDARY_SOLANA_RPC_URL=

# Reserved for later infrastructure; the observation-only worker does not use
# these values. Never commit real values.
PUBLIC_WEBHOOK_BASE_URL=
HELIUS_WEBHOOK_AUTH_TOKEN=
DATABASE_URL=
REDIS_URL=
