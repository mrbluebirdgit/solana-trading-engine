# Non-secret runtime controls
NODE_ENV=development
TRADING_MODE=observe
LIVE_TRADING_ENABLED=false

# Telegram user API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The Telegram session is generated locally during first authorization.
# QR authorization is preferred, so no phone number belongs in GitHub.
TELEGRAM_SESSION_PATH=.secrets/telegram.session

# Helius Solana RPC and data infrastructure
HELIUS_API_KEY=

# GMGN is one read-only intelligence source, never the engine's authority.
GMGN_API_KEY=

# Jupiter supplies read-only price and route data. Wallet signing remains local.
JUPITER_API_KEY=

# Telegram Bot API for alerts and authenticated control commands
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Remaining market, wallet, social, and verification sources
BIRDEYE_API_KEY=
CIELO_API_KEY=
X_BEARER_TOKEN=
SOLSCAN_API_KEY=
SECONDARY_SOLANA_RPC_URL=

# Created during always-on paper deployment; never commit real values.
PUBLIC_WEBHOOK_BASE_URL=
HELIUS_WEBHOOK_AUTH_TOKEN=
DATABASE_URL=
REDIS_URL=
