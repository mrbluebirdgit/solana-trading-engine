FROM node:22-bookworm-slim

LABEL org.opencontainers.image.title="Robinhood Chain momentum watcher" \
      org.opencontainers.image.description="Alert-only Pons launch watcher; no wallet and no trade execution"

ENV NODE_ENV=production \
    ROBINHOOD_WATCHER_ENABLED=false \
    ROBINHOOD_HEALTH_PORT=3100 \
    ROBINHOOD_STATE_PATH=/var/lib/robinhood-watcher/state.json

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY scripts ./scripts
COPY src ./src

RUN mkdir -p /var/lib/robinhood-watcher \
    && chown node:node /var/lib/robinhood-watcher

USER node

EXPOSE 3100
VOLUME ["/var/lib/robinhood-watcher"]
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + process.env.ROBINHOOD_HEALTH_PORT + '/readyz').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1));"

CMD ["node", "scripts/run-robinhood-watcher.mjs"]

